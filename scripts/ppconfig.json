{"name":"cdbaaebddfabaed","url":"index.html (等资源+1)","showName":"diudiu","appid":"com.cdbaaebddfabaed.pakeplus","icon":"","iconPath":"","iconRound":true,"state":true,"single":true,"injectJq":true,"tauriApi":false,"devbug":false,"version":"0.0.1","preview":"iPhone","platform":["1-1","2-2","3-1"],"width":430,"height":932,"desc":"","jsFile":[],"filterCss":"","customJs":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"theme-color\" content=\"#F7F4EE\">\n  <title>计划</title>\n  <style>\n    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body { height: 100%; }\n    body {\n      background: linear-gradient(135deg, #E5E0D8, #D8D3CB);\n      display: flex; align-items: center; justify-content: center;\n      min-height: 100vh; padding: 20px;\n      font-family: 'Noto Sans SC', -apple-system, 'PingFang SC', sans-serif;\n      color: #2D2A26; -webkit-font-smoothing: antialiased;\n    }\n\n    :root {\n      --bg: #F7F4EE; --card: #FFFFFF;\n      --sage: #94A89A; --honey: #B89968; --green: #7BA688;\n      --gray: #E8E4DB; --gray2: #F0EDE6;\n      --t1: #2D2A26; --t2: #8C8579; --t3: #B5AFA3;\n      --num: 'Inter', -apple-system, sans-serif;\n    }\n\n    .phone {\n      width: 390px; height: 844px;\n      background: var(--bg); border-radius: 44px;\n      overflow: hidden; position: relative;\n      box-shadow: 0 0 0 10px #1C1C1E, 0 30px 80px rgba(0,0,0,.25);\n      display: flex; flex-direction: column;\n    }\n    @media (max-width: 430px) {\n      body { background: var(--bg); padding: 0; }\n      .phone { width: 100vw; height: 100vh; border-radius: 0; box-shadow: none; }\n    }\n\n    .page-wrap { flex: 1; overflow: hidden; position: relative; }\n    .page {\n      position: absolute; inset: 0; overflow-y: auto;\n      padding: 20px; display: none; flex-direction: column;\n    }\n    .page.active { display: flex; animation: fadeIn .25s ease; }\n    .page::-webkit-scrollbar { display: none; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }\n\n    /* Header */\n    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 18px; flex-shrink: 0; }\n    .header-left { display: flex; flex-direction: column; gap: 3px; }\n    .h-title { font-size: 22px; font-weight: 600; letter-spacing: -.3px; }\n    .h-sub { font-size: 13px; color: var(--t2); }\n    .add-btn {\n      width: 36px; height: 36px; background: var(--sage);\n      border-radius: 18px; border: none; cursor: pointer;\n      display: flex; align-items: center; justify-content: center;\n      flex-shrink: 0; transition: transform .15s;\n      box-shadow: 0 2px 8px rgba(148,168,154,.3);\n    }\n    .add-btn:active { transform: scale(.88); }\n\n    /* Tab Bar */\n    .tabbar {\n      height: 65px; background: var(--card);\n      display: flex; align-items: center; justify-content: space-evenly;\n      padding: 12px 0 8px; flex-shrink: 0;\n      border-top: 1px solid rgba(232,228,219,.5);\n    }\n    .tab {\n      background: none; border: none; cursor: pointer;\n      font-family: inherit; font-size: 13px; color: var(--t3);\n      display: flex; flex-direction: column; align-items: center; gap: 4px;\n      padding: 4px 10px; transition: color .2s;\n    }\n    .tab.active { font-weight: 600; color: var(--sage); }\n    .tab-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--sage); opacity: 0; transition: opacity .2s; }\n    .tab.active .tab-dot { opacity: 1; }\n\n    /* === Day Plan === */\n    .day-cols { display: flex; flex: 1; gap: 0; }\n    .day-col { flex: 1; display: flex; flex-direction: column; }\n    .day-col.l { padding-right: 14px; }\n    .day-col.r { padding-left: 14px; border-left: 1px solid var(--gray); }\n    .col-h { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }\n    .col-h-t { font-size: 15px; font-weight: 600; }\n    .col-h-c { font-family: var(--num); font-size: 11px; font-weight: 600; color: var(--t2); background: var(--gray); padding: 2px 7px; border-radius: 10px; }\n\n    .todo-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; cursor: pointer; }\n    .todo-item:active { opacity: .6; }\n    .cb {\n      width: 22px; height: 22px; border: 2px solid var(--gray); border-radius: 50%;\n      flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all .2s;\n    }\n    .cb.on { background: var(--green); border-color: var(--green); }\n    .todo-txt { font-size: 14px; line-height: 1.4; word-break: break-all; }\n    .todo-txt.done { text-decoration: line-through; color: var(--t3); }\n\n    .empty-hint { font-size: 13px; color: var(--t3); padding: 20px 0; text-align: center; }\n\n    /* === Notebook List (Week/Month/Year) === */\n    .notebook { display: flex; flex-direction: column; gap: 2px; }\n    .nb-item {\n      display: flex; align-items: flex-start; gap: 12px;\n      padding: 12px 0; border-bottom: 1px solid var(--gray2);\n      cursor: pointer;\n    }\n    .nb-item:active { background: var(--gray2); }\n    .nb-num {\n      font-family: var(--num); font-size: 14px; font-weight: 500;\n      color: var(--t3); min-width: 24px; text-align: right; line-height: 22px;\n    }\n    .nb-cb {\n      width: 20px; height: 20px; border: 2px solid var(--gray); border-radius: 5px;\n      flex-shrink: 0; margin-top: 1px; display: flex; align-items: center; justify-content: center;\n      transition: all .2s;\n    }\n    .nb-cb.on { background: var(--sage); border-color: var(--sage); }\n    .nb-txt { font-size: 14px; line-height: 1.5; flex: 1; word-break: break-all; }\n    .nb-txt.done { text-decoration: line-through; color: var(--t3); }\n    .nb-del {\n      width: 24px; height: 24px; border: none; background: none; cursor: pointer;\n      color: var(--t3); font-size: 18px; display: flex; align-items: center; justify-content: center;\n      opacity: 0; transition: opacity .2s; flex-shrink: 0;\n    }\n    .nb-item:hover .nb-del { opacity: 1; }\n\n    /* === Countdown === */\n    .cd-card {\n      background: var(--card); border-radius: 14px; padding: 16px;\n      display: flex; justify-content: space-between; align-items: center;\n      box-shadow: 0 1px 3px rgba(0,0,0,.03); margin-bottom: 12px;\n    }\n    .cd-left { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }\n    .cd-name { font-size: 15px; font-weight: 500; word-break: break-all; }\n    .cd-date { font-family: var(--num); font-size: 13px; color: var(--t2); }\n    .cd-right { display: flex; align-items: baseline; gap: 2px; flex-shrink: 0; margin-left: 12px; }\n    .cd-days { font-family: var(--num); font-size: 28px; font-weight: 700; line-height: 1; }\n    .cd-unit { font-size: 13px; color: var(--t2); }\n    .cd-del {\n      width: 24px; height: 24px; border: none; background: none; cursor: pointer;\n      color: var(--t3); font-size: 16px; flex-shrink: 0; margin-left: 8px;\n    }\n\n    /* === Health === */\n    .h-card { background: var(--card); border-radius: 14px; padding: 16px; margin-bottom: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.03); }\n    .h-card-t { font-size: 16px; font-weight: 600; margin-bottom: 14px; }\n    .weight-display { display: flex; align-items: baseline; gap: 6px; margin-bottom: 14px; }\n    .weight-val { font-family: var(--num); font-size: 42px; font-weight: 700; line-height: 1; letter-spacing: -1px; }\n    .weight-unit { font-family: var(--num); font-size: 16px; font-weight: 500; color: var(--t2); }\n    .weight-trend { font-family: var(--num); font-size: 14px; font-weight: 500; margin-left: 8px; }\n    .weight-trend.up { color: var(--honey); }\n    .weight-trend.down { color: var(--green); }\n    .weight-trend.flat { color: var(--t2); }\n    .h-btns { display: flex; gap: 10px; margin-bottom: 14px; }\n    .btn-p { flex: 1; background: var(--sage); color: #fff; border: none; border-radius: 12px; padding: 10px 0; font-family: inherit; font-size: 13px; font-weight: 500; cursor: pointer; transition: transform .15s; }\n    .btn-p:active { transform: scale(.97); }\n    .btn-s { flex: 1; background: transparent; color: var(--t2); border: 1px solid var(--gray); border-radius: 12px; padding: 10px 0; font-family: inherit; font-size: 13px; font-weight: 500; cursor: pointer; transition: transform .15s; }\n    .btn-s:active { transform: scale(.97); }\n    .record { display: flex; align-items: center; justify-content: space-between; padding: 9px 0; }\n    .record + .record { border-top: 1px solid var(--gray); }\n    .r-date { font-size: 12px; color: var(--t2); }\n    .r-val { font-family: var(--num); font-size: 14px; font-weight: 500; }\n    .r-trend { font-family: var(--num); font-size: 12px; font-weight: 500; }\n    .r-trend.up { color: var(--honey); }\n    .r-trend.down { color: var(--green); }\n    .r-trend.flat { color: var(--t2); }\n\n    .meal-row { display: flex; gap: 14px; align-items: flex-start; padding: 8px 0; }\n    .meal-row + .meal-row { border-top: 1px solid var(--gray2); }\n    .meal-label { font-size: 14px; font-weight: 500; width: 42px; flex-shrink: 0; line-height: 1.6; }\n    .meal-items { flex: 1; display: flex; flex-direction: column; gap: 2px; }\n    .meal-item { font-size: 13px; color: var(--t2); line-height: 1.6; }\n    .meal-add { display: inline-flex; align-items: center; gap: 5px; color: var(--sage); font-size: 13px; font-weight: 500; cursor: pointer; }\n    .meal-add:active { opacity: .6; }\n    .meal-del { color: var(--t3); font-size: 12px; cursor: pointer; margin-left: 8px; }\n\n    /* === Modal / Input Overlay === */\n    .overlay {\n      position: absolute; inset: 0; background: rgba(0,0,0,.3);\n      display: none; align-items: flex-end; justify-content: center; z-index: 100;\n    }\n    .overlay.show { display: flex; animation: fadeIn .2s ease; }\n    .modal {\n      background: var(--card); width: 100%; border-radius: 20px 20px 0 0;\n      padding: 24px 20px 32px; animation: slideUp .3s ease;\n    }\n    @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }\n    .modal-title { font-size: 17px; font-weight: 600; text-align: center; margin-bottom: 20px; }\n    .modal-input {\n      width: 100%; border: 1.5px solid var(--gray); border-radius: 12px;\n      padding: 12px 14px; font-family: inherit; font-size: 15px; color: var(--t1);\n      background: var(--bg); outline: none; transition: border-color .2s;\n    }\n    .modal-input:focus { border-color: var(--sage); }\n    .modal-row { display: flex; gap: 10px; margin-bottom: 10px; }\n    .modal-row .modal-input { flex: 1; }\n    .modal-btns { display: flex; gap: 10px; margin-top: 16px; }\n    .modal-btn-ok { flex: 1; background: var(--sage); color: #fff; border: none; border-radius: 12px; padding: 12px 0; font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer; }\n    .modal-btn-cancel { flex: 1; background: var(--gray2); color: var(--t2); border: none; border-radius: 12px; padding: 12px 0; font-family: inherit; font-size: 15px; cursor: pointer; }\n    .modal-label { font-size: 13px; color: var(--t2); margin-bottom: 6px; margin-top: 14px; }\n    .modal-hint { font-size: 12px; color: var(--t3); margin-top: 10px; text-align: center; }\n\n    .check-svg { width: 12px; height: 12px; }\n    .check-svg-sm { width: 10px; height: 10px; }\n  </style>\n</head>\n<body>\n  <div class=\"phone\">\n    <div class=\"page-wrap\">\n\n      <!-- ===== 日计划 ===== -->\n      <div class=\"page active\" data-page=\"day\">\n        <div class=\"header\">\n          <div class=\"header-left\">\n            <div class=\"h-title\">今天</div>\n            <div class=\"h-sub\" id=\"day-date\"></div>\n          </div>\n          <button class=\"add-btn\" onclick=\"openModal('day')\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 3.5V12.5M3.5 8H12.5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n          </button>\n        </div>\n        <div class=\"day-cols\">\n          <div class=\"day-col l\">\n            <div class=\"col-h\"><span class=\"col-h-t\">待办</span><span class=\"col-h-c\" id=\"day-pending-count\">0</span></div>\n            <div id=\"day-pending\"></div>\n          </div>\n          <div class=\"day-col r\">\n            <div class=\"col-h\"><span class=\"col-h-t\">已完成</span><span class=\"col-h-c\" id=\"day-done-count\">0</span></div>\n            <div id=\"day-done\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- ===== 周计划 ===== -->\n      <div class=\"page\" data-page=\"week\">\n        <div class=\"header\">\n          <div class=\"header-left\">\n            <div class=\"h-title\">本周</div>\n            <div class=\"h-sub\" id=\"week-range\"></div>\n          </div>\n          <button class=\"add-btn\" onclick=\"openModal('week')\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 3.5V12.5M3.5 8H12.5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n          </button>\n        </div>\n        <div class=\"notebook\" id=\"week-list\"></div>\n      </div>\n\n      <!-- ===== 月计划 ===== -->\n      <div class=\"page\" data-page=\"month\">\n        <div class=\"header\">\n          <div class=\"header-left\">\n            <div class=\"h-title\">本月</div>\n            <div class=\"h-sub\" id=\"month-label\"></div>\n          </div>\n          <button class=\"add-btn\" onclick=\"openModal('month')\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 3.5V12.5M3.5 8H12.5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n          </button>\n        </div>\n        <div class=\"notebook\" id=\"month-list\"></div>\n      </div>\n\n      <!-- ===== 年计划 ===== -->\n      <div class=\"page\" data-page=\"year\">\n        <div class=\"header\">\n          <div class=\"header-left\">\n            <div class=\"h-title\" id=\"year-title\"></div>\n            <div class=\"h-sub\">年度计划</div>\n          </div>\n          <button class=\"add-btn\" onclick=\"openModal('year')\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 3.5V12.5M3.5 8H12.5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n          </button>\n        </div>\n        <div class=\"notebook\" id=\"year-list\"></div>\n      </div>\n\n      <!-- ===== 倒计时 ===== -->\n      <div class=\"page\" data-page=\"countdown\">\n        <div class=\"header\">\n          <div class=\"header-left\">\n            <div class=\"h-title\">倒计时</div>\n            <div class=\"h-sub\">重要日期</div>\n          </div>\n          <button class=\"add-btn\" onclick=\"openModal('countdown')\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 3.5V12.5M3.5 8H12.5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n          </button>\n        </div>\n        <div id=\"cd-list\"></div>\n      </div>\n\n      <!-- ===== 健康 ===== -->\n      <div class=\"page\" data-page=\"health\">\n        <div class=\"header\">\n          <div class=\"header-left\">\n            <div class=\"h-title\">健康</div>\n            <div class=\"h-sub\">今日记录</div>\n          </div>\n          <button class=\"add-btn\" onclick=\"openModal('health-meal')\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 3.5V12.5M3.5 8H12.5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n          </button>\n        </div>\n\n        <div class=\"h-card\">\n          <div class=\"h-card-t\">体重</div>\n          <div class=\"weight-display\">\n            <span class=\"weight-val\" id=\"w-val\">--</span>\n            <span class=\"weight-unit\">kg</span>\n            <span class=\"weight-trend flat\" id=\"w-trend\"></span>\n          </div>\n          <div class=\"h-btns\">\n            <button class=\"btn-p\" onclick=\"openModal('weight')\">手动记录</button>\n            <button class=\"btn-s\" onclick=\"alert('体脂秤连接功能需要配合硬件设备使用')\">连接体脂秤</button>\n          </div>\n          <div id=\"w-records\"></div>\n        </div>\n\n        <div class=\"h-card\">\n          <div class=\"h-card-t\">今日饮食</div>\n          <div id=\"diet-list\"></div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Tab Bar -->\n    <nav class=\"tabbar\">\n      <button class=\"tab active\" data-tab=\"day\"><span>日</span><span class=\"tab-dot\"></span></button>\n      <button class=\"tab\" data-tab=\"week\"><span>周</span><span class=\"tab-dot\"></span></button>\n      <button class=\"tab\" data-tab=\"month\"><span>月</span><span class=\"tab-dot\"></span></button>\n      <button class=\"tab\" data-tab=\"year\"><span>年</span><span class=\"tab-dot\"></span></button>\n      <button class=\"tab\" data-tab=\"countdown\"><span>计时</span><span class=\"tab-dot\"></span></button>\n      <button class=\"tab\" data-tab=\"health\"><span>健康</span><span class=\"tab-dot\"></span></button>\n    </nav>\n\n    <!-- Modal -->\n    <div class=\"overlay\" id=\"overlay\" onclick=\"closeModalBg(event)\">\n      <div class=\"modal\" id=\"modal\" onclick=\"event.stopPropagation()\">\n        <div class=\"modal-title\" id=\"modal-title\">添加</div>\n        <div id=\"modal-body\"></div>\n        <div class=\"modal-btns\">\n          <button class=\"modal-btn-cancel\" onclick=\"closeModal()\">取消</button>\n          <button class=\"modal-btn-ok\" id=\"modal-ok\" onclick=\"confirmModal()\">确定</button>\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <script>\n    // ============ Data Layer (localStorage) ============\n    const DB = {\n      get(key, def) { try { return JSON.parse(localStorage.getItem(key)) ?? def; } catch { return def; } },\n      set(key, val) { localStorage.setItem(key, JSON.stringify(val)); }\n    };\n\n    let data = {\n      day: DB.get('plan_day', []),          // [{id, text, done}]\n      week: DB.get('plan_week', []),        // [{id, text, done}]\n      month: DB.get('plan_month', []),      // [{id, text, done}]\n      year: DB.get('plan_year', []),        // [{id, text, done}]\n      countdown: DB.get('plan_cd', []),     // [{id, name, date}]\n      weights: DB.get('plan_w', []),        // [{id, date, weight}]\n      diet: DB.get('plan_diet', {}),        // {breakfast:[], lunch:[], dinner:[]}\n    };\n\n    function save(key) { DB.set('plan_' + key, data[key]); }\n\n    function uid() { return Date.now() + '_' + Math.random().toString(36).slice(2, 6); }\n\n    // ============ Date Helpers ============\n    const now = new Date();\n    const weekdays = ['周日','周一','周二','周三','周四','周五','周六'];\n    function fmtDate(d) { return (d.getMonth()+1) + '月' + d.getDate() + '日 ' + weekdays[d.getDay()]; }\n    function fmtDateShort(d) { return (d.getMonth()+1) + '月' + d.getDate() + '日'; }\n    function daysBetween(d1, d2) {\n      return Math.ceil((d2 - d1) / 86400000);\n    }\n    function todayStr() {\n      const d = new Date();\n      return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');\n    }\n\n    // ============ SVG ============\n    const CHECK = '<svg class=\"check-svg\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2.5 6L5 8.5L9.5 3.5\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n    const CHECK_SM = '<svg class=\"check-svg-sm\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2.5 6L5 8.5L9.5 3.5\" stroke=\"#fff\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n    const PLUS_SM = '<svg width=\"12\" height=\"12\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M7 2.5V11.5M2.5 7H11.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>';\n\n    // ============ Render: Day Plan ============\n    function renderDay() {\n      const pending = data.day.filter(i => !i.done);\n      const done = data.day.filter(i => i.done);\n\n      document.getElementById('day-pending-count').textContent = pending.length;\n      document.getElementById('day-done-count').textContent = done.length;\n\n      const pe = document.getElementById('day-pending');\n      const de = document.getElementById('day-done');\n\n      pe.innerHTML = pending.length ? pending.map(i =>\n        `<div class=\"todo-item\" onclick=\"toggleDay('${i.id}')\">\n          <div class=\"cb\"></div><span class=\"todo-txt\">${esc(i.text)}</span>\n        </div>`\n      ).join('') : '<div class=\"empty-hint\">点击 + 添加待办</div>';\n\n      de.innerHTML = done.length ? done.map(i =>\n        `<div class=\"todo-item\" onclick=\"toggleDay('${i.id}')\">\n          <div class=\"cb on\">${CHECK}</div><span class=\"todo-txt done\">${esc(i.text)}</span>\n        </div>`\n      ).join('') : '';\n    }\n\n    function toggleDay(id) {\n      const item = data.day.find(i => i.id === id);\n      if (item) { item.done = !item.done; save('day'); renderDay(); }\n    }\n\n    // ============ Render: Notebook (Week/Month/Year) ============\n    function renderNotebook(key) {\n      const list = data[key];\n      const el = document.getElementById(key + '-list');\n      el.innerHTML = list.length ? list.map((i, idx) =>\n        `<div class=\"nb-item\" onclick=\"toggleNB('${key}','${i.id}')\">\n          <span class=\"nb-num\">${idx + 1}</span>\n          <div class=\"nb-cb ${i.done ? 'on' : ''}\">${i.done ? CHECK_SM : ''}</div>\n          <span class=\"nb-txt ${i.done ? 'done' : ''}\">${esc(i.text)}</span>\n          <button class=\"nb-del\" onclick=\"delNB(event,'${key}','${i.id}')\">&times;</button>\n        </div>`\n      ).join('') : '<div class=\"empty-hint\">点击 + 添加计划</div>';\n    }\n\n    function toggleNB(key, id) {\n      const item = data[key].find(i => i.id === id);\n      if (item) { item.done = !item.done; save(key); renderNotebook(key); }\n    }\n\n    function delNB(e, key, id) {\n      e.stopPropagation();\n      data[key] = data[key].filter(i => i.id !== id);\n      save(key); renderNotebook(key);\n    }\n\n    // ============ Render: Countdown ============\n    function renderCountdown() {\n      const el = document.getElementById('cd-list');\n      const today = new Date(); today.setHours(0,0,0,0);\n\n      el.innerHTML = data.countdown.length ? data.countdown.map(c => {\n        const target = new Date(c.date);\n        const days = daysBetween(today, target);\n        const isPast = days < 0;\n        const color = c.important ? 'var(--honey)' : 'var(--sage)';\n        return `<div class=\"cd-card\">\n          <div class=\"cd-left\">\n            <div class=\"cd-name\" style=\"${c.important ? 'font-weight:700;color:var(--honey)' : ''}\">${esc(c.name)}</div>\n            <div class=\"cd-date\">${fmtDateShort(target)}</div>\n          </div>\n          <div class=\"cd-right\">\n            <span class=\"cd-days\" style=\"color:${color}\">${Math.abs(days)}</span>\n            <span class=\"cd-unit\">${isPast ? '天前' : '天'}</span>\n          </div>\n          <button class=\"cd-del\" onclick=\"delCD('${c.id}')\">&times;</button>\n        </div>`;\n      }).join('') : '<div class=\"empty-hint\">点击 + 添加倒计时</div>';\n    }\n\n    function delCD(id) {\n      data.countdown = data.countdown.filter(c => c.id !== id);\n      save('countdown'); renderCountdown();\n    }\n\n    // ============ Render: Health ============\n    function renderHealth() {\n      // Weight\n      const ws = data.weights;\n      const wVal = document.getElementById('w-val');\n      const wTrend = document.getElementById('w-trend');\n      const wRec = document.getElementById('w-records');\n\n      if (ws.length === 0) {\n        wVal.textContent = '--';\n        wTrend.textContent = '';\n        wTrend.className = 'weight-trend flat';\n        wRec.innerHTML = '<div class=\"empty-hint\" style=\"padding:10px 0\">暂无记录</div>';\n      } else {\n        const latest = ws[ws.length - 1];\n        wVal.textContent = latest.weight;\n\n        if (ws.length >= 2) {\n          const prev = ws[ws.length - 2];\n          const diff = latest.weight - prev.weight;\n          if (Math.abs(diff) < 0.05) {\n            wTrend.textContent = '- 持平';\n            wTrend.className = 'weight-trend flat';\n          } else if (diff > 0) {\n            wTrend.textContent = '\\u2191 ' + diff.toFixed(1) + ' kg';\n            wTrend.className = 'weight-trend up';\n          } else {\n            wTrend.textContent = '\\u2193 ' + Math.abs(diff).toFixed(1) + ' kg';\n            wTrend.className = 'weight-trend down';\n          }\n        } else {\n          wTrend.textContent = '';\n        }\n\n        // Records (latest 5, reverse)\n        const recent = ws.slice(-5).reverse();\n        wRec.innerHTML = recent.map((r, idx) => {\n          const nextIdx = ws.length - 1 - idx;\n          let trendHtml = '';\n          if (nextIdx > 0) {\n            const prevW = ws[nextIdx - 1];\n            const diff = r.weight - prevW.weight;\n            if (Math.abs(diff) < 0.05) { trendHtml = '<span class=\"r-trend flat\">-</span>'; }\n            else if (diff > 0) { trendHtml = '<span class=\"r-trend up\">\\u2191' + diff.toFixed(1) + '</span>'; }\n            else { trendHtml = '<span class=\"r-trend down\">\\u2193' + Math.abs(diff).toFixed(1) + '</span>'; }\n          }\n          return `<div class=\"record\">\n            <span class=\"r-date\">${esc(r.date)}</span>\n            <span class=\"r-val\">${r.weight} kg</span>\n            ${trendHtml}\n          </div>`;\n        }).join('');\n      }\n\n      // Diet\n      const meals = ['breakfast', 'lunch', 'dinner'];\n      const labels = { breakfast: '早餐', lunch: '午餐', dinner: '晚餐' };\n      if (!data.diet.breakfast) { data.diet = { breakfast: [], lunch: [], dinner: [] }; }\n      const dietEl = document.getElementById('diet-list');\n      dietEl.innerHTML = meals.map(m => {\n        const items = data.diet[m] || [];\n        const itemsHtml = items.length ? items.map(it =>\n          `<div class=\"meal-item\">${esc(it)} <span class=\"meal-del\" onclick=\"delMeal('${m}','${esc(it)}')\">&times;</span></div>`\n        ).join('') : '';\n        return `<div class=\"meal-row\">\n          <div class=\"meal-label\">${labels[m]}</div>\n          <div class=\"meal-items\">\n            ${itemsHtml}\n            <div class=\"meal-add\" onclick=\"openModal('meal-${m}')\">${PLUS_SM}<span>添加</span></div>\n          </div>\n        </div>`;\n      }).join('');\n    }\n\n    function delMeal(meal, item) {\n      data.diet[meal] = data.diet[meal].filter(i => i !== item);\n      save('diet'); renderHealth();\n    }\n\n    // ============ Modal ============\n    let modalMode = null;\n\n    function openModal(mode) {\n      modalMode = mode;\n      const overlay = document.getElementById('overlay');\n      const title = document.getElementById('modal-title');\n      const body = document.getElementById('modal-body');\n\n      const inputHtml = (placeholder, type, id) =>\n        `<input class=\"modal-input\" type=\"${type||'text'}\" id=\"${id}\" placeholder=\"${placeholder}\" autocomplete=\"off\">`;\n\n      if (mode === 'day') {\n        title.textContent = '添加待办';\n        body.innerHTML = inputHtml('输入待办内容...', 'text', 'm-input');\n      } else if (mode === 'week' || mode === 'month' || mode === 'year') {\n        title.textContent = '添加' + ({week:'周',month:'月',year:'年'})[mode] + '计划';\n        body.innerHTML = inputHtml('输入计划内容...', 'text', 'm-input');\n      } else if (mode === 'countdown') {\n        title.textContent = '添加倒计时';\n        body.innerHTML =\n          inputHtml('事件名称（如：妈妈生日）', 'text', 'm-name') +\n          '<div class=\"modal-label\">目标日期</div>' +\n          `<input class=\"modal-input\" type=\"date\" id=\"m-date\" value=\"${todayStr()}\">` +\n          '<div class=\"modal-hint\">勾选重要事件会以金色标注</div>' +\n          '<div style=\"display:flex;align-items:center;gap:8px;margin-top:12px\"><input type=\"checkbox\" id=\"m-imp\" style=\"width:18px;height:18px\"><label for=\"m-imp\" style=\"font-size:14px;color:var(--t2)\">标记为重要</label></div>';\n      } else if (mode === 'weight') {\n        title.textContent = '记录体重';\n        body.innerHTML = inputHtml('输入体重 (kg)', 'number', 'm-weight') +\n          '<div class=\"modal-label\">日期</div>' +\n          `<input class=\"modal-input\" type=\"date\" id=\"m-wdate\" value=\"${todayStr()}\">`;\n      } else if (mode && mode.startsWith('meal-')) {\n        const meal = mode.split('-')[1];\n        const labels = { breakfast: '早餐', lunch: '午餐', dinner: '晚餐' };\n        title.textContent = '添加' + labels[meal];\n        body.innerHTML = inputHtml('输入食物（如：燕麦粥）', 'text', 'm-meal');\n      } else if (mode === 'health-meal') {\n        title.textContent = '添加饮食';\n        body.innerHTML =\n          '<div class=\"modal-label\">选择餐次</div>' +\n          '<div style=\"display:flex;gap:8px;margin-bottom:10px\">' +\n            ['breakfast','lunch','dinner'].map(m => `<button class=\"btn-s\" style=\"flex:1;padding:8px 0\" id=\"meal-sel-${m}\" onclick=\"selectMeal('${m}')\">${({breakfast:'早餐',lunch:'午餐',dinner:'晚餐'})[m]}</button>`).join('') +\n          '</div>' +\n          inputHtml('输入食物', 'text', 'm-meal-input');\n        selectMeal('breakfast');\n      }\n\n      overlay.classList.add('show');\n      setTimeout(() => { const inp = body.querySelector('input'); if (inp) inp.focus(); }, 300);\n    }\n\n    let selectedMeal = 'breakfast';\n    function selectMeal(m) {\n      selectedMeal = m;\n      ['breakfast','lunch','dinner'].forEach(x => {\n        const el = document.getElementById('meal-sel-' + x);\n        if (el) {\n          if (x === m) { el.style.borderColor = 'var(--sage)'; el.style.color = 'var(--sage)'; }\n          else { el.style.borderColor = 'var(--gray)'; el.style.color = 'var(--t2)'; }\n        }\n      });\n    }\n\n    function closeModal() {\n      document.getElementById('overlay').classList.remove('show');\n      modalMode = null;\n    }\n\n    function closeModalBg(e) { if (e.target.id === 'overlay') closeModal(); }\n\n    function confirmModal() {\n      if (modalMode === 'day') {\n        const v = document.getElementById('m-input').value.trim();\n        if (!v) return;\n        data.day.push({ id: uid(), text: v, done: false });\n        save('day'); renderDay();\n      } else if (modalMode === 'week' || modalMode === 'month' || modalMode === 'year') {\n        const v = document.getElementById('m-input').value.trim();\n        if (!v) return;\n        data[modalMode].push({ id: uid(), text: v, done: false });\n        save(modalMode); renderNotebook(modalMode);\n      } else if (modalMode === 'countdown') {\n        const name = document.getElementById('m-name').value.trim();\n        const date = document.getElementById('m-date').value;\n        const imp = document.getElementById('m-imp').checked;\n        if (!name || !date) return;\n        data.countdown.push({ id: uid(), name, date, important: imp });\n        save('countdown'); renderCountdown();\n      } else if (modalMode === 'weight') {\n        const w = parseFloat(document.getElementById('m-weight').value);\n        const d = document.getElementById('m-wdate').value;\n        if (isNaN(w) || w <= 0) return;\n        const dateLabel = d ? d.replace(/-/g, '/').slice(5) + '日' : fmtDateShort(new Date());\n        data.weights.push({ id: uid(), date: dateLabel, weight: w });\n        save('weights'); renderHealth();\n      } else if (modalMode && modalMode.startsWith('meal-')) {\n        const meal = modalMode.split('-')[1];\n        const v = document.getElementById('m-meal').value.trim();\n        if (!v) return;\n        if (!data.diet[meal]) data.diet[meal] = [];\n        data.diet[meal].push(v);\n        save('diet'); renderHealth();\n      } else if (modalMode === 'health-meal') {\n        const v = document.getElementById('m-meal-input').value.trim();\n        if (!v) return;\n        if (!data.diet[selectedMeal]) data.diet[selectedMeal] = [];\n        data.diet[selectedMeal].push(v);\n        save('diet'); renderHealth();\n      }\n      closeModal();\n    }\n\n    // Enter key to confirm\n    document.addEventListener('keydown', e => {\n      if (e.key === 'Enter' && document.getElementById('overlay').classList.contains('show')) {\n        e.preventDefault();\n        confirmModal();\n      }\n    });\n\n    // ============ Esc ============\n    function esc(s) {\n      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n    }\n\n    // ============ Tab Switching ============\n    document.querySelectorAll('.tab').forEach(tab => {\n      tab.addEventListener('click', () => {\n        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\n        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));\n        tab.classList.add('active');\n        document.querySelector('.page[data-page=\"' + tab.dataset.tab + '\"]').classList.add('active');\n      });\n    });\n\n    // ============ Init ============\n    document.getElementById('day-date').textContent = fmtDate(now);\n\n    // Week range\n    const monday = new Date(now);\n    monday.setDate(now.getDate() - ((now.getDay() + 6) % 7));\n    const sunday = new Date(monday);\n    sunday.setDate(monday.getDate() + 6);\n    document.getElementById('week-range').textContent = fmtDateShort(monday) + ' - ' + fmtDateShort(sunday);\n\n    document.getElementById('month-label').textContent = (now.getMonth() + 1) + '月';\n    document.getElementById('year-title').textContent = now.getFullYear() + '年';\n\n    renderDay();\n    renderNotebook('week');\n    renderNotebook('month');\n    renderNotebook('year');\n    renderCountdown();\n    renderHealth();\n  </script>\n</body>\n</html>\n","isHtml":true,"htmlPath":"/Volumes/丢丢透明/软件","htmlFiles":[],"prefix":"","pcRepo":"PakePlus","iosRepo":"PakePlus-iOS","androidRepo":"PakePlus-Android","win7Repo":"","versionStr":"web10","more":{"windows":{"label":"cdbaaebddfabaed","title":"diudiu","url":"index.html (等资源+1)","userAgent":"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0_3 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1","width":430,"height":932,"theme":null,"resizable":true,"fullscreen":false,"maximized":false,"minWidth":400,"minHeight":300,"maxWidth":1920,"maxHeight":1080,"decorations":true,"transparent":false,"titleBarStyle":"Visible","visible":true,"focus":true,"closable":true,"minimizable":true,"maximizable":true,"alwaysOnTop":false,"alwaysOnBottom":false,"center":false,"shadow":true,"skipTaskbar":false,"tabbingIdentifier":null,"parent":null,"dragDropEnabled":true,"browserExtensionsEnabled":false,"devtools":true,"contentProtected":false,"hiddenTitle":false,"incognito":false,"proxyUrl":null,"useHttpsScheme":false,"zoomHotkeysEnabled":false,"acceptFirstMouse":false,"create":false,"backgroundColor":null,"backgroundThrottling":null,"javascriptDisabled":false}},"phone":{"fullScreen":false,"launchImage":"","screenOn":false,"download":true,"internet":true,"position":false,"direction":"default","callPhone":false,"microphone":false,"camera":false,"backgroundPlay":false,"compress":false,"appSize":0,"videoFull":true,"author":"pakeplus","startMethod":"none","startPwd":"","pwdTitle":"","pwdBtn":"","pwdPlace":"","pwdTip":"","pwdError":"","endPwd":"","endPwdTitle":"","endPwdTip":"","endPwdError":"","pwdStyle":"flat","pwdTheme":"dark","safeArea":{"top":0,"bottom":0,"left":0,"right":0},"header":{"show":false,"title":"","backgroundColor":"","color":"","fontSize":16,"fontWeight":"bold","loading":false,"toolBar":false,"toolBarBackgroundColor":"","toolBarColor":"","toolBarFontSize":16,"toolBarFontWeight":"bold"},"siderMenu":{"show":false,"width":0,"backgroundColor":"","color":"","fontSize":16,"